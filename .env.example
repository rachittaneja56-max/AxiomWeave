SIH_ENVIRONMENT=development
SIH_HOST=127.0.0.1
SIH_PORT=8000
SIH_DATABASE_URL=sqlite:///./axiomweave.db
SIH_PRIVATE_ASSET_DIR=.private-assets
SIH_PRIVATE_ASSET_BACKEND=local
# Set these with SIH_PRIVATE_ASSET_BACKEND=s3 for private S3-compatible storage.
SIH_S3_BUCKET=
SIH_S3_ENDPOINT=
SIH_S3_REGION=
SIH_ALLOW_REGISTRATION=false
SIH_ALLOWED_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIH_RATE_LIMIT_ENABLED=true
OPENAI_API_KEY=
SIH_OPENAI_MODEL=gpt-6-luna
SIH_OPENAI_UTILITY_MODEL=gpt-5-nano
# Optional task-profile overrides; blank values use the profile defaults above.
SIH_OPENAI_ACTION_MODEL=
SIH_OPENAI_EVIDENCE_MODEL=
SIH_OPENAI_CONSISTENCY_MODEL=
SIH_OPENAI_OCR_MODEL=
